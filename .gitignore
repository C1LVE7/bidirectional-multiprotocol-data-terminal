# ==========================================================
# Keil MDK 编译产物
# 用 "目录/*" 而不是 "目录/"，否则负向规则（!）不生效
# ==========================================================
MDK-ARM/project/*
!MDK-ARM/project/project.sct

# 中间文件与最终产物
*.o
*.d
*.crf
*.axf
*.hex
*.bin
*.map
*.lnp
*.lst
*.dep
*.htm

# Keil 界面状态与调试器日志（每台机器不同，不入库）
*.uvguix.*
*.uvoptx.bak
*.uvprojx.bak
JLinkLog.txt
JLinkSettings.ini

# 构建日志
build_log.txt
*.log

# ==========================================================
# IDE / 编辑器 / 系统
# ==========================================================
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
